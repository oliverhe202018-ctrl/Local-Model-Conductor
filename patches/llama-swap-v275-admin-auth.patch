diff --git a/internal/server/auth.go b/internal/server/auth.go
index 0000001..0000002 100644
--- a/internal/server/auth.go
+++ b/internal/server/auth.go
@@ -40,6 +40,36 @@ func CreateAuthMiddleware(cfg config.Config) chain.Middleware {
 	}
 }
 
+// CreateAdminAuthMiddleware enforces separate Guard-only adminApiKeys on mutating
+// management routes so inference-only Agent keys receive HTTP 403/401.
+func CreateAdminAuthMiddleware(cfg config.Config) chain.Middleware {
+	adminKeys := cfg.AdminAPIKeys
+	return func(next http.Handler) http.Handler {
+		if len(adminKeys) == 0 {
+			// Fail-closed when adminApiKeys is omitted in hardened builds: reject all mutating admin calls
+			return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				swaputil.SendResponse(w, r, http.StatusForbidden, "forbidden: adminApiKeys not configured")
+			})
+		}
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			provided := swaputil.ExtractAPIKey(r)
+			for _, key := range adminKeys {
+				if subtle.ConstantTimeCompare([]byte(provided), []byte(key)) == 1 {
+					next.ServeHTTP(w, r)
+					return
+				}
+			}
+			status := http.StatusUnauthorized
+			if provided != "" {
+				status = http.StatusForbidden
+			}
+			swaputil.SendResponse(w, r, status, "forbidden: Guard admin credential required")
+		})
+	}
+}
